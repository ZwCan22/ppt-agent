# Start with an empty context and allow only the runtime files.
**
!Dockerfile
!.dockerignore
!requirements.lock.txt
!app/
!app/**
!worker.py
!alembic.ini
!migrations/
!migrations/**

# Exclude generated bytecode and nested local configuration as well.
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/.env
**/.env.*
